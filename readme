Option 1 - Scraping interactif :

bash
python scrape_prospects.py
Option 2 - Ajout en masse via API :

bash
python bulk_add_prospects.py
Option 3 - Automatique complet :

bash
python auto_prospect.py

####################Frontend######################## 
npm install
npm run dev
####################backend#########################
python -m venv venv
.\venv\Scripts\Activate.ps1   # Windows : venv\Scripts\activate

# Dépendances
pip install -r requirements.txt*
#Installer beautifulSoup Model
python -m pip install beautifulsoup4
#Installer gemini Model
python -m pip install --upgrade google-genai

#Lancer le backend 
 uvicorn app.main:app --host 0.0.0.0 --port 8000 --reload